<Window x:Class="DimmerClone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dimmer Control Panel" Width="500" Height="400"
        Icon="Icon.png"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        BorderBrush="{StaticResource SurfaceBrush}"
        BorderThickness="1">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"  
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>

    <Border BorderThickness="1" BorderBrush="#333333">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}" Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Image Grid.Column="0" Source="Icon.png" Width="16" Height="16" Margin="10,0,5,0" VerticalAlignment="Center"/>

                <!-- Title for dragging -->
                <TextBlock Grid.Column="1" Text="Dimmer" VerticalAlignment="Center" 
                           Foreground="{StaticResource TextBrush}" FontSize="12" Margin="5,0,0,0"
                           MouseLeftButtonDown="TitleBar_MouseDown"/>

                <!-- Minimize Button -->
                <Button Grid.Column="2" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" 
                        Click="MinimizeButton_Click"
                        Width="46" Height="32" Background="Transparent" Foreground="{StaticResource TextBrush}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Close (X) Button -->
                <Button Grid.Column="3" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" 
                        Click="CloseButton_Click"
                        Width="46" Height="32" Background="Transparent" Foreground="{StaticResource TextBrush}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            
            <!-- Separator below title bar -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="#333333"/>

            <!-- Main Header Section -->
            <StackPanel Grid.Row="1" Margin="80,30,80,20">
                <TextBlock Text="Taskbar Dimmer" FontSize="22" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}" 
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="Global System Brightness" FontSize="14" 
                           Foreground="{StaticResource MutedTextBrush}" 
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>

            <!-- Main Control: Single Large Slider -->
            <StackPanel Grid.Row="2" Margin="100,20,100,20" VerticalAlignment="Top">
                
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Brightness" FontWeight="Medium" FontSize="14" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="BrightnessValueText" Text="100%" FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" FontSize="14"/>
                </Grid>

                <Slider x:Name="GlobalSlider"
                        Minimum="10" Maximum="100" 
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="GlobalSlider_ValueChanged"
                        Height="30"/>
            </StackPanel>

            <!-- Footer Section -->
            <StackPanel Grid.Row="3" Margin="80,10,80,30">
                <!-- Status -->
                <TextBlock x:Name="StatusText" Text="Ready" 
                           Foreground="{StaticResource MutedTextBrush}" 
                           TextWrapping="Wrap" FontSize="11" 
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
